{
  "name": "cremind-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Token-less OAuth broker + event relay for Cremind (Cloudflare Workers + Durable Objects).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=dist",
    "deploy:full": "npm run web:build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "web:install": "npm ci --prefix web",
    "web:build": "npm run build --prefix web",
    "ensure-web-out": "node -e \"require('fs').mkdirSync('web/out',{recursive:true})\"",
    "pretest": "npm run ensure-web-out",
    "pretest:watch": "npm run ensure-web-out"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250906.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "~3.2.4",
    "wrangler": "^4.30.0"
  },
  "dependencies": {
    "hono": "^4.6.3"
  }
}
