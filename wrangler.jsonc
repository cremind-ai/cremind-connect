{
	// cremind-connect — token-less OAuth broker + event relay.
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cremind-connect",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	// Static marketing site (Next.js export in ./web) served via Workers Static
	// Assets. The API/WebSocket routes listed in run_worker_first ALWAYS invoke
	// the Worker first and can never be shadowed by an asset; every other path
	// (/, /contact, /privacy, /terms, /_next/*) is served asset-first. Unmatched
	// paths fall through to the Worker's JSON 404 (not_found_handling: none).
	// Build the assets first: `npm run web:build` (see package.json).
	"assets": {
		"directory": "./web/out",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none",
		"run_worker_first": [
			"/healthz",
			"/.well-known/*",
			"/credentials/*",
			"/ingress/*",
			"/oauth/*",
			"/subscribe"
		]
	},
	// Durable Objects (require a paid Workers plan).
	"durable_objects": {
		"bindings": [
			{
				"name": "ACCOUNT_HUB",
				"class_name": "AccountHub"
			}
		]
	},
	// AccountHub is intentionally stateless (live sockets only). SQLite-backed
	// classes are the modern default and are required on the free plan; the DO
	// uses no storage, so the backend choice is functionally a no-op here.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"AccountHub"
			]
		}
	],
	// KV: JWKS cache (outside DO memory) + single-use nonce store for ID-token replay protection.
	// Replace the placeholder ids before `wrangler deploy` (see SETUP.md).
	"kv_namespaces": [
		{
			"binding": "JWKS_CACHE",
			"id": "2fab43ab28ba43d2aaa4bc86b8295394",
			"remote": true
		},
		{
			"binding": "NONCE_SEEN",
			"id": "9be45325ca4f447f841de773ea3dcdbd",
			"remote": true
		}
	],
	// Public, non-secret configuration. Secrets go via `wrangler secret put`
	// (see SETUP.md + the per-provider guides SETUP-GCP.md / SETUP-ATLASSIAN.md):
	//   RELAY_SIGNING_KEY, RELAY_SIGNING_KEY_PREV (optional), CALENDAR_WEBHOOK_HMAC_KEY (optional),
	//   GOOGLE_CLIENT_SECRET (non-confidential Desktop secret; kept out of git but served at /credentials/google),
	//   ATLASSIAN_CLIENT_SECRET (CONFIDENTIAL Atlassian 3LO app secret; held server-side only, NEVER served)
	"vars": {
		"RELAY_VERSION": "0.1.0",
		"PUBLIC_BASE_URL": "https://connect.cremind.io",
		"RELAY_WS_URL": "wss://connect.cremind.io/subscribe",
		"GOOGLE_CLIENT_ID": "446044769188-1c8ngd1lps4p493s2vpbcvsn3a5nqc57.apps.googleusercontent.com",
		// Every scope here must stay *sensitive* — a restricted scope
		// (gmail.readonly, full drive, ...) would subject the shared OAuth client to
		// a recurring third-party CASA security assessment.
		"GOOGLE_SCOPES_GMAIL": "openid email https://www.googleapis.com/auth/gmail.send",
		"GOOGLE_SCOPES_CALENDAR": "openid email https://www.googleapis.com/auth/calendar.events",
		"GOOGLE_SCOPES_DRIVE": "openid email https://www.googleapis.com/auth/drive.file",
		"GOOGLE_SCOPES_SHEETS": "openid email https://www.googleapis.com/auth/spreadsheets",
		"GOOGLE_SCOPES_DOCS": "openid email https://www.googleapis.com/auth/documents",
		"SESSION_TTL_SECONDS": "3600",
		"NONCE_WINDOW_SECONDS": "600",
		"CALENDAR_REQUIRE_HMAC": "false",
		"ATLASSIAN_CLIENT_ID": "Q5jayQ7bOHd7ZbrGHiYtnNLpbrtxFx2k",
		"ATLASSIAN_SCOPES_JIRA": "read:jira-work write:jira-work read:jira-user manage:jira-webhook read:me offline_access",
		"ATLASSIAN_SCOPES_CONFLUENCE": "read:confluence-content.all write:confluence-content read:confluence-space.summary search:confluence read:me offline_access"
	},
	"observability": {
		"enabled": true
	},
	// Custom domain: connect.cremind.io routes to this Worker. Requires the
	// cremind.io zone to be on this Cloudflare account; wrangler provisions the
	// DNS record + TLS cert on deploy. workers.dev + preview URLs are disabled so
	// the relay is reachable ONLY at its canonical host (the OIDC audience the
	// relay verifies is bound to connect.cremind.io).
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "connect.cremind.io", "custom_domain": true }
	],
	"dev": {
		"port": 8787
	}
}